# Detector:
#   objects - 80 COCO classes via YOLOX + OpenCV DNN (default; needs the model,
#             fetch with: python -m scripts.download_models)
#   yunet   - face detection (tiny bundled model, works out of the box)
#   stub    - deterministic, offline (used by tests/CI)
#   yolo    - ultralytics YOLO (needs PyTorch; may be unavailable on new Pythons)
DETECTOR=objects
OBJECT_MODEL=models/object_detection_yolox.onnx
YUNET_MODEL=models/face_detection_yunet.onnx
YOLO_MODEL=yolov8n.pt

# Video analysis
VIDEO_FRAME_STEP=15      # analyse every Nth frame
MAX_FRAMES=300           # cap frames analysed per video

# Image
DOMINANT_COLORS_K=4
MIN_CONFIDENCE=0.6

LOG_LEVEL=INFO
